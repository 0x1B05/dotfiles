def_key "?"
    show_help

def_key "k"
    scroll_up

def_key "j"
    scroll_down

def_key "g"
    move_home

def_key "G"
    move_end

def_key "ctrl-u"
    page_up

def_key "ctrl-d"
    page_down

def_key "left"
    seek_backward

def_key "right"
    seek_forward

def_key "home"
    move_home

def_key "end"
    move_end

def_key "d"
    delete_playlist_items

def_key "delete"
    delete_playlist_items

def_key "delete"
    delete_stored_playlist

def_key "l"
    enter_directory

def_key "l"
    next_column

def_key "h"
    jump_to_parent_directory

def_key "h"
    previous_column

def_key "tab"
    next_screen

def_key "shift-tab"
    previous_screen

# Space controls playback; a adds the highlighted song or directory to the queue.
def_key "a"
    add_item_to_playlist

# Only remove queue entries or saved lists, never music files in the browser.
def_key "d"
    delete_stored_playlist

def_key "c"
    clear_main_playlist

def_key "C"
    clear_main_playlist

def_key "L"
    show_lyrics

def_key "space"
    pause

def_key "t"
    jump_to_playing_song

def_key "s"
    toggle_visualization_type

def_key "s"
    stop
